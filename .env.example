# Direct Vercel AI Gateway — Jev is typesafe-ai/jev.
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev
JEV_GATEWAY_ENDPOINT=https://ai-gateway.vercel.sh/v4/ai/evaluation-model
JEV_CALLS_PER_EPOCH=1
JEV_TIMEOUT_MS=2600

# Optional fallback if a Gateway key is unavailable. The local bot always
# prefers AI_GATEWAY_API_KEY when both are present.
# JEV_PROVIDER=openai
# OPENAI_BASE_URL=http://ai/v1
# JEV_PROXY_MODEL=google/gemini-3.1-flash-lite

# Startup default. The HUD and extension popup can switch recommendation-only,
# auto-play bot match, or a hard auto-off override while the process is running.
# Ranked/human/private matches remain recommendation-only at the click boundary.
CATANBOT_MODE=recommend

# Local HUD / API
CATANBOT_PORT=8765
